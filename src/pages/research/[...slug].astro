---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import EsZeroLogon from '../../i18n/zerologon-domain-compromise.es.mdx';

export async function getStaticPaths() {
  const posts = await getCollection('research', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Spanish translations for individual writeups, shown/hidden by the site's
// EN/ES toggle (LangScript swaps [data-lang-content] blocks). Writeups without
// an entry here simply stay English-only.
const translations: Record<
  string,
  { Content: any; title: string; summary: string; severity?: string; status: string }
> = {
  'zerologon-domain-compromise': {
    Content: EsZeroLogon,
    title: 'Compromiso de dominio vía ZeroLogon, y ayudando a solucionarlo',
    summary:
      'Detecté que el controlador de dominio de mi centro educativo estaba expuesto a ZeroLogon (CVE-2020-1472), demostré el impacto de forma responsable, lo reporté de inmediato y colaboré con el centro para remediar y reforzar la infraestructura.',
    severity: 'CVSS 10.0 (Crítico)',
    status: 'Divulgado y remediado',
  },
};

const t = translations[post.id];
const EsContent = t?.Content;
---

<Base title={`${post.data.title} · Alan Ortega`} description={post.data.summary}>
  <Nav />
  <main id="top" class="writeup">
    <div class="wrap">
      <a href="/research/" class="link">
        <span data-lang-content="en">&larr; Research</span>
        {t && <span data-lang-content="es" hidden>&larr; Investigación</span>}
      </a>

      <header class="writeup-head">
        <p class="t-data writeup-meta">
          <span>{post.data.project}</span>
          {
            post.data.severity && (
              <span>
                <span data-lang-content="en">{post.data.severity}</span>
                {t?.severity && (
                  <span data-lang-content="es" hidden>
                    {t.severity}
                  </span>
                )}
              </span>
            )
          }
          <span>
            <span data-lang-content="en">{post.data.status}</span>
            {t && <span data-lang-content="es" hidden>{t.status}</span>}
          </span>
          <span>{post.data.date.toISOString().slice(0, 10)}</span>
        </p>

        <h1 class="t-huge writeup-title">
          <span data-lang-content="en">{post.data.title}</span>
          {t && <span data-lang-content="es" hidden>{t.title}</span>}
        </h1>

        <p class="t-body writeup-summary">
          <span data-lang-content="en">{post.data.summary}</span>
          {t && <span data-lang-content="es" hidden>{t.summary}</span>}
        </p>
      </header>

      <article class="prose-brut">
        <div data-lang-content="en"><Content /></div>
        {
          EsContent && (
            <div data-lang-content="es" hidden>
              <EsContent />
            </div>
          )
        }
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .writeup {
    padding-top: 8rem;
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .writeup-head {
    margin-top: 2rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 2px solid var(--rule);
    padding-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .writeup-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin-bottom: 1.5rem;
  }

  .writeup-title {
    max-width: 20ch;
  }

  .writeup-summary {
    margin-top: 1.75rem;
    max-width: 60ch;
    color: var(--color-data);
  }
</style>
