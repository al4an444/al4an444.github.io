      'skills.cat2': 'Sistemas y redes',
      'skills.cat3': 'Idiomas',
      // Experience
      'exp.eyebrow': '# Experiencia y formación',
      'exp.title': 'La trayectoria.',
      'exp.edu': 'Formación',
      'exp.exp': 'Experiencia',
      'exp.certs': 'Certificaciones — autoformación',
      // Projects
      'projects.eyebrow': '# Proyectos',
      'projects.title': 'Lo que construyo.',
      // Certifications
      'certs.view': 'Ver título ↗',
      // At a glance
      'glance.eyebrow': '# De un vistazo',
      'glance.title': 'Todo, en 10 segundos.',
      'glance.l0': 'Rol',
      'glance.v0': 'Investigador de seguridad',
      'glance.l1': 'Enfoque',
      'glance.v1': 'Revisión de código y vuln research',
      'glance.l2': 'Trayectoria',
      'glance.v2': '12 reportes · 4 plataformas',
      'glance.l3': 'Destacado',
      'glance.v3': 'grpc-go CVSS 7.5 — corregido por Google',
      'glance.l4': 'Formación',
      'glance.v4': 'ASIR (grado superior), 2025–2027',
      'glance.l5': 'Idiomas',
      'glance.v5': 'Español · Inglés',
      'glance.l6': 'Ubicación',
      'glance.v6': 'Madrid → Países Bajos',
      'glance.l7': 'Disponible para',
      'glance.v7': 'Roles junior de appsec / vuln research · NL o remoto',
      'glance.btnCV': 'Descargar CV',
      'glance.btnList': 'Lista completa de investigación',
      // Contact
      'contact.title': 'Encontremos el próximo bug<span class="text-emerald-400">.</span>',
      'contact.desc':
        'Disponible para roles junior en seguridad de aplicaciones, investigación de vulnerabilidades o ingeniería de seguridad — Países Bajos o remoto.',
      // Footer
      'footer.built': 'hecho con Astro · cero JS innecesario',
      // Homepage <title> / meta description
      'meta.title': 'Alan Ortega — Investigador de Seguridad',
      'meta.desc':
        'Investigador de seguridad autodidacta que encuentra y divulga responsablemente vulnerabilidades en software ampliamente utilizado. 12 reportes a través del VRP de código abierto de Google, incluido un bypass de autenticación CVSS 7.5 en grpc-go corregido por Google.',
    };

    const originals = new Map();

    function apply(lang) {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!originals.has(el)) originals.set(el, el.innerHTML);
        if (lang === 'es' && es[key] != null) el.innerHTML = es[key];
        else el.innerHTML = originals.get(el);
      });
      // Swap whole content blocks by language (e.g. bilingual writeups).
      document.querySelectorAll('[data-lang-content]').forEach((el) => {
        el.hidden = el.getAttribute('data-lang-content') !== lang;
      });
      document.documentElement.lang = lang;
      // Homepage <title> + meta description (writeup pages keep their own).
      if (location.pathname === '/') {
        const desc = document.querySelector('meta[name="description"]');
        if (!originals.has('meta')) {
          originals.set('meta', {
            title: document.title,
            desc: desc ? desc.getAttribute('content') : '',
          });
        }
        const saved = originals.get('meta');
        document.title = lang === 'es' ? es['meta.title'] : saved.title;
        if (desc) desc.setAttribute('content', lang === 'es' ? es['meta.desc'] : saved.desc);
      }
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.textContent = lang === 'en' ? 'Español' : 'English';
        btn.setAttribute('aria-label', lang === 'en' ? 'Cambiar a español' : 'Switch to English');
      });
    }

    let current = localStorage.getItem('lang') === 'es' ? 'es' : 'en';

    function wire() {
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          current = current === 'en' ? 'es' : 'en';
          localStorage.setItem('lang', current);
          apply(current);
        });
      });
      apply(current);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wire);
    } else {
      wire();
    }
  })();
</script>
