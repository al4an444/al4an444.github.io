---
const links = [
  { href: '/#research', label: 'Research' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#certifications', label: 'Certs' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-zinc-900 bg-zinc-950/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6">
    <a href="/" class="font-mono text-sm font-medium text-zinc-100 transition-colors hover:text-emerald-400">
      alan@ortega<span class="text-emerald-400">:~$</span>
    </a>
    <div class="flex items-center gap-5 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hidden text-zinc-400 transition-colors hover:text-zinc-100 sm:block"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/cv.pdf"
        class="rounded border border-zinc-700 px-3 py-1 font-mono text-xs text-zinc-300 transition-colors hover:border-emerald-400 hover:text-emerald-400"
      >
        CV
      </a>
    </div>
  </nav>
  <div class="scroll-progress h-px w-full bg-emerald-400"></div>
</header>
