---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const writeups = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Research · Alan Ortega"
  description="Technical writeups by Alan Ortega. Detailed writeups are published only once a finding is public; active reports stay at vendor, severity and status."
>
  <Nav />

  <main id="top" class="research-main">
    <div class="wrap">
      <p class="t-data">Archive</p>
      <h1 class="t-huge research-title">Research</h1>

      <p class="t-body research-lead">
        Writeups are published only once a finding is public. Active reports stay at vendor,
        severity and status, with no exploitable detail.
      </p>

      <div class="ledger research-list">
        {
          writeups.map((post, i) => (
            <a href={`/research/${post.id}/`} class="ledger-row project-row">
              <span class="ledger-no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="ledger-vendor">{post.data.project}</h2>
                <p class="t-data-sm ledger-scope">{post.data.date.toISOString().slice(0, 10)}</p>
              </div>
              <div>
                <p class="research-item-title">{post.data.title}</p>
                <p class="ledger-detail">{post.data.summary}</p>
              </div>
              <div class="ledger-meta">
                <p class="ledger-status is-fixed">{post.data.status}</p>
                {post.data.severity && <p class="t-data-sm">{post.data.severity}</p>}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .research-main {
    padding-top: 8rem;
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .research-title {
    margin-top: 0.75rem;
  }

  .research-lead {
    margin-top: 2rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
    max-width: 48ch;
  }

  .research-list {
    border-top: 2px solid var(--rule);
  }

  .research-item-title {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }
</style>
