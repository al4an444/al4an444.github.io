---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import T from '../components/T.astro';
---

<Base
  title="Nothing here · Alan Ortega Álamo"
  description="This address does not exist on al4an444.github.io."
  alternate={false}
>
  <Nav alternate={false} />

  <main id="top" class="notfound">
    <div class="wrap">
      <p class="t-data"><T k="nf.kicker">Dead end</T></p>

      <h1 class="t-mega notfound-code">404</h1>

      <p class="t-body notfound-lead"><T k="nf.lead">
        You went looking for something that isn't here. Poking at addresses is most of the job, so
        I won't hold it against you. This one is just a dead end.
      </T></p>

      <div class="notfound-actions">
        <a href="/" class="link"><T k="nf.btn.home">Back to the start</T></a>
        <a href="/research/" class="link"><T k="nf.btn.research">See the research</T></a>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .notfound {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .notfound-code {
    margin-top: 0.75rem;
  }

  .notfound-lead {
    margin-top: 2.5rem;
  }

  .notfound-actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
</style>
