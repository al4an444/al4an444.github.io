---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('research', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Alan Ortega`} description={post.data.summary}>
  <Nav />
  <main class="mx-auto max-w-3xl px-6 pt-32 pb-16">
    <a href="/research/" class="font-mono text-xs text-zinc-500 transition-colors hover:text-emerald-400">
      &larr; back to research
    </a>
    <header class="mt-6 mb-10 border-b border-zinc-900 pb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="font-medium text-zinc-100">{post.data.project}</span>
        {
          post.data.severity && (
            <span
              class:list={[
                'rounded border px-2 py-0.5',
                post.data.severity.toLowerCase().includes('critical')
                  ? 'border-red-500/50 bg-red-500/10 text-red-400'
                  : 'border-emerald-400/40 bg-emerald-400/10 text-emerald-400',
              ]}
            >
              {post.data.severity}
            </span>
          )
        }
        <span class="rounded border border-zinc-600 bg-zinc-800/60 px-2 py-0.5 text-zinc-400">
          {post.data.status}
        </span>
        <span class="text-zinc-500">{post.data.date.toISOString().slice(0, 10)}</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-100">{post.data.title}</h1>
      <p class="mt-3 text-zinc-400">{post.data.summary}</p>
    </header>
    <article
      class="prose prose-invert max-w-none prose-headings:tracking-tight prose-a:text-emerald-400 prose-code:text-emerald-300"
    >
      <Content />
    </article>
  </main>
  <Footer />
</Base>
