---
// Lightweight client-side EN→ES toggle. English is the DOM default and primary
// language; this script swaps the innerHTML of [data-i18n] elements to Spanish
// and back. Choice is persisted in localStorage. No build/routing changes.
---

<script is:inline>
  (() => {
    const es = {
      // Nav
      'nav.about': 'Sobre mí',
      'nav.education': 'Formación',
      'nav.work': 'Trabajo',
      'nav.skills': 'Habilidades',
      'nav.projects': 'Proyectos',
      'nav.contact': 'Contacto',
      // Intro
      'hero.kicker': 'Disponible para roles junior de seguridad',
      'hero.lead': 'Investigador de seguridad autodidacta.',
      'hero.m1.l': 'Ubicación',
      'hero.m1.v': 'Madrid, España',
      'hero.m2.l': 'Me mudo a',
      'hero.m2.v': 'Países Bajos',
      'hero.m3.l': 'Fondo',
      'hero.m3.v': '240 trazos plotados, un hilo',
      'hero.btn.work': 'Ver el trabajo',
      'hero.btn.contact': 'Hablemos',
      // 01 · About
      'about.eyebrow': 'Quién soy',
      'about.title': 'Veinte años.<br />Totalmente autodidacta.',
      'about.p1':
        'Vivo en Madrid y me mudo a los Países Bajos. Reviso software muy utilizado en busca de <span class="text-zinc-100">bypasses de autenticación y autorización</span>, <span class="text-zinc-100">problemas de integridad en la cadena de suministro</span> y <span class="text-zinc-100">bugs de denegación de servicio</span>.',
      'about.p2':
        'Nadie me asignó esto. Lo aprendí leyendo el código de otros, y todo lo que encuentro pasa por el canal de divulgación del propio fabricante, nunca por otro sitio.',
      // 02 · Education
      'edu.eyebrow': 'Qué he estudiado',
      'edu.title': 'Formación reglada,<br />más la parte que hice yo.',
      'edu.school': 'Formación',
      'edu.work': 'Experiencia',
      'edu.certs': 'Certificaciones de autoformación',
      // 03 · Work
      'work.eyebrow': 'Con quién trabajo',
      'work.title': 'Google, Microsoft<br />y NVIDIA.',
      'work.google.status': 'Corregido · v1.81.1',
      'work.google.desc':
        'Un bypass de autenticación en el motor xDS RBAC de gRPC: el authenticatedMatcher caía desde el SAN URI/DNS hasta el Subject DN del certificado. Corregido por Google y citado por nombre en las notas de versión.',
      'work.microsoft.status': 'En revisión',
      'work.microsoft.desc':
        'Reportado a través de MSRC y actualmente en revisión. Los detalles se mantienen reservados hasta que se resuelva.',
      'work.nvidia.status': 'Reproducido · en revisión',
      'work.nvidia.desc':
        'El equipo de seguridad de NVIDIA confirmó y reprodujo el reporte, que ahora está en revisión activa. Los detalles se mantienen reservados hasta que se resuelva.',
      'work.note':
        'Los reportes abiertos se quedan en este nivel: fabricante, severidad y estado, nada explotable. Siguen así hasta que el fabricante los resuelva y los publique.',
      'work.all': 'Todos los hallazgos &rarr;',
      // Skills
      'skills.eyebrow': 'Habilidades',
      'skills.title': 'Con lo que trabajo.',
      'skills.cat0': 'Seguridad',
      'skills.cat1': 'Programación',
      'skills.cat2': 'Sistemas y redes',
      'skills.cat3': 'Idiomas',
      // Projects
      'projects.eyebrow': 'Lo que construyo',
      'projects.title': 'Lo que construyo.',
      // Case study
      'case.eyebrow': 'Caso de estudio',
      'case.status': 'Divulgado y remediado',
      'case.title': 'Compromiso de dominio vía ZeroLogon (CVE-2020-1472), y la solución',
      'case.desc':
        'Detecté que el controlador de dominio de mi centro estaba expuesto a ZeroLogon, demostré el impacto de forma responsable, lo reporté de inmediato y colaboré con el centro para remediar y reforzar la infraestructura.',
      'case.link': 'Leer el caso de estudio &rarr;',
      // Contact
      'contact.title': 'Hablemos<span class="text-emerald-600">.</span>',
      'contact.desc':
        'Disponible para roles junior en seguridad de aplicaciones, investigación de vulnerabilidades o ingeniería de seguridad, en Países Bajos o remoto.',
      // 404
      'nf.kicker': 'Callejón sin salida',
      'nf.title': 'Este camino no lleva a ninguna parte.',
      'nf.lead':
        'Fuiste a buscar algo que no está aquí. Curiosear direcciones es buena parte del trabajo, así que no te lo tendré en cuenta. Esta es solo un callejón sin salida.',
      'nf.btn.home': 'Volver al principio',
      'nf.btn.research': 'Ver la investigación',
      // Footer
      'footer.built': 'hecho con Astro · cero JS innecesario',
      // Homepage <title> / meta description
      'meta.title': 'Alan Ortega · Investigador de Seguridad',
      'meta.desc':
        'Investigador de seguridad autodidacta que encuentra y divulga responsablemente vulnerabilidades en software ampliamente utilizado, incluido un bypass de autenticación CVSS 7.5 en grpc-go corregido por Google.',
    };

    const originals = new Map();

    function apply(lang) {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!originals.has(el)) originals.set(el, el.innerHTML);
        if (lang === 'es' && es[key] != null) el.innerHTML = es[key];
        else el.innerHTML = originals.get(el);
      });
      // Swap whole content blocks by language (e.g. bilingual writeups).
      document.querySelectorAll('[data-lang-content]').forEach((el) => {
        el.hidden = el.getAttribute('data-lang-content') !== lang;
      });
      document.documentElement.lang = lang;
      // Homepage <title> + meta description (writeup pages keep their own).
      if (location.pathname === '/') {
        const desc = document.querySelector('meta[name="description"]');
        if (!originals.has('meta')) {
          originals.set('meta', {
            title: document.title,
            desc: desc ? desc.getAttribute('content') : '',
          });
        }
        const saved = originals.get('meta');
        document.title = lang === 'es' ? es['meta.title'] : saved.title;
        if (desc) desc.setAttribute('content', lang === 'es' ? es['meta.desc'] : saved.desc);
      }
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.textContent = lang === 'en' ? 'Español' : 'English';
        btn.setAttribute('aria-label', lang === 'en' ? 'Cambiar a español' : 'Switch to English');
      });
    }

    let current = localStorage.getItem('lang') === 'es' ? 'es' : 'en';

    function wire() {
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          current = current === 'en' ? 'es' : 'en';
          localStorage.setItem('lang', current);
          apply(current);
        });
      });
      apply(current);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wire);
    } else {
      wire();
    }
  })();
</script>
