---
// A hard bar ruled off from the page. No pill, no blur, no glass, no cursor
// highlight, no fake shell prompt — all of that was the previous design and all
// of it is on the blacklist. Just the name, the sections, and the language.
const links = [
  { href: '/#findings', label: 'Findings', key: 'nav.findings' },
  { href: '/#zerologon', label: 'Case', key: 'nav.case' },
  { href: '/#about', label: 'About', key: 'nav.about' },
  { href: '/research/', label: 'Research', key: 'nav.research' },
  { href: '/#contact', label: 'Contact', key: 'nav.contact' },
];
---

<header class="topbar">
  <div class="wrap topbar-in">
    <a href="/" class="topbar-name">Alan Ortega</a>

    <nav class="topbar-links" aria-label="Sections">
      {
        links.map((link) => (
          <a href={link.href} data-i18n={link.key} data-nav-link>
            {link.label}
          </a>
        ))
      }
    </nav>

    <button type="button" data-lang-toggle aria-label="Switch to Spanish">Español</button>
  </div>
</header>
