<script>
  /* ------------- Certificate lightbox ------------- */
  const lightbox = document.getElementById('cert-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('cert-lightbox-img') as HTMLImageElement | null;
  if (lightbox && lightboxImg) {
    const img = lightboxImg;
    const box = lightbox;
    document.querySelectorAll<HTMLButtonElement>('[data-cert-image]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.certImage ?? '';
        img.alt = btn.dataset.certAlt ?? '';
        box.setAttribute('aria-label', img.alt || 'Certificate');
        box.showModal();
      });
    });
    document.getElementById('cert-lightbox-close')?.addEventListener('click', () => box.close());
    // A click that lands on the dialog itself (not its children) is on the backdrop.
    box.addEventListener('click', (event) => {
      if (event.target === box) box.close();
    });
  }
</script>
