---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { projects, certifications } from '../data/findings';

const skills = [
  {
    category: 'Security',
    items:
      'Vulnerability research · source-code review (Go, C/C++, Python) · authentication/authorization bypass analysis · AI-assisted red teaming · supply-chain & build integrity · denial-of-service analysis · Active Directory exploitation (ZeroLogon, DCSync, Pass-the-Hash) · responsible disclosure · CVSS v3.1 scoring · PoC development',
  },
  {
    category: 'Programming',
    items:
      'Go · Python · C · C++ · C# · Bash · JavaScript / TypeScript · HTML / CSS / Tailwind · frontend & backend web',
  },
  {
    category: 'Systems & Networking',
    items: 'Linux & Windows administration · network configuration · virtualization',
  },
  {
    category: 'Languages',
    items: 'Spanish (native) · English (professional working proficiency)',
  },
];

const education = [
  {
    title: 'Higher Vocational Degree (HND) in Network Systems Administration (ASIR)',
    place: 'IES Jovellanos / ILERNA Online',
    period: '2025 to 2027 (in progress)',
  },
  {
    title: 'Vocational Diploma in Microcomputer Systems & Networks (SMR)',
    place: '',
    period: '2023 to 2025',
  },
];

const experience = [
  {
    title: 'Technical Support',
    place: 'MOMPALAO, IT company, Malta',
    period: 'Mar to May 2025',
  },
  {
    title: 'Seasonal work while studying',
    place: 'Slagharen Theme Park (NL) · El Corte Inglés (ES)',
    period: 'Nov 2024 to Aug 2025',
  },
];

// Vendors whose security teams have handled my reports. Google's finding is
// public and fully documented; the NVIDIA and Microsoft reports are still open,
// so they stay high-level — vendor, severity, status, nothing more.
const vendors = [
  {
    key: 'google',
    name: 'Google',
    scope: 'grpc-go · Open Source VRP',
    status: 'Fixed · v1.81.1',
    statusKind: 'fixed',
    severity: 'CVSS 7.5',
    payout: '$3,133',
    links: [
      { href: 'https://github.com/grpc/grpc-go/pull/9111', label: 'Fix PR #9111' },
      {
        href: 'https://newreleases.io/project/github/grpc/grpc-go/release/v1.81.1',
        label: 'Release notes',
      },
    ],
  },
  {
    key: 'microsoft',
    name: 'Microsoft',
    scope: 'Azure · MSRC',
    status: 'Under review',
    statusKind: 'open',
    severity: 'High',
    payout: '$10,000',
    links: [],
  },
  {
    key: 'nvidia',
    name: 'NVIDIA',
    scope: 'PSIRT · Public Bug Bounty',
    status: 'Reproduced · under review',
    statusKind: 'open',
    severity: 'High',
    payout: '$4,000',
    links: [],
  },
];
---

<Base
  title="Alan Ortega · Security Researcher"
  description="Self-taught security researcher finding and responsibly disclosing vulnerabilities in widely-used software, including a CVSS 7.5 authentication bypass in grpc-go fixed by Google."
>
  <Nav />
  <main id="top">
    <!-- ============================== Intro ============================= -->
    <section id="hero" class="relative isolate flex min-h-[100svh] flex-col justify-center">
      <div class="hero-exit mx-auto w-full max-w-5xl px-6 pt-24">
        <!-- Masthead: the plotter writes the name across the full measure. -->
        <h1 class="name-draw intro-masthead" style="--i: 0">
          <span class="name-ink">Alan Ortega</span>
          <span class="name-pen" aria-hidden="true"></span>
        </h1>

        <div class="intro-rule" style="--i: 1" aria-hidden="true"></div>

        <!-- Body: statement on the left, plate annotations in the margin. -->
        <div class="intro-cols">
          <div class="intro-main" style="--i: 2">
            <p data-i18n="hero.lead" class="hero-lead">Self-taught security researcher.</p>

            <div class="intro-actions">
              <a href="#work" data-i18n="hero.btn.work" class="btn btn-primary">See the work</a>
              <a href="#contact" data-i18n="hero.btn.contact" class="btn btn-ghost">Get in touch</a>
            </div>
          </div>

          <aside class="intro-margin" style="--i: 3">
            <p class="intro-status">
              <span class="pulse-dot"></span>
              <span data-i18n="hero.kicker">Open to junior security roles</span>
            </p>

            <dl class="intro-meta">
              <div>
                <dt data-i18n="hero.m1.l">Based</dt>
                <dd data-i18n="hero.m1.v">Madrid, Spain</dd>
              </div>
              <div>
                <dt data-i18n="hero.m2.l">Moving to</dt>
                <dd data-i18n="hero.m2.v">the Netherlands</dd>
              </div>
              <div>
                <dt data-i18n="hero.m3.l">Backdrop</dt>
                <dd data-i18n="hero.m3.v">240 plotted traces, one thread</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>

      <div class="absolute inset-x-0 bottom-8 flex justify-center">
        <a href="#about" aria-label="Scroll down" class="scroll-hint text-zinc-500">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 5v14M19 12l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </section>

    <!-- ===================== Cinema: three stations ===================== -->
    <div class="cinema">
      <!-- The one green thread, drawn as you pass through the three stations. -->
      <div class="cinema-thread" aria-hidden="true">
        <svg viewBox="0 0 60 900" preserveAspectRatio="xMidYMid meet" fill="none">
          <path
            class="thread-line"
            pathLength="1"
            d="M30 0 C 30 90, 8 130, 8 220 S 52 310, 52 450 S 8 590, 8 680 S 30 810, 30 900"
            stroke="var(--color-accent)"
            stroke-width="1.6"
            stroke-linecap="round"
          />
          <circle class="thread-dot thread-dot-1" cx="8" cy="220" r="4" fill="var(--color-accent)" />
          <circle class="thread-dot thread-dot-2" cx="52" cy="450" r="4" fill="var(--color-accent)" />
          <circle class="thread-dot thread-dot-3" cx="8" cy="680" r="4" fill="var(--color-accent)" />
        </svg>
      </div>

      <!-- ---------------------- 01 · Who I am --------------------------- -->
      <section id="about" class="stage">
        <div class="stage-in">
          <div class="stage-body">
            <p class="station"><span class="station-no">01</span><span
                data-i18n="about.eyebrow">Who I am</span></p>
            <h2 data-i18n="about.title" class="heading stage-title">
              Twenty years old.<br />Entirely self-taught.
            </h2>
            <p data-i18n="about.p1" class="stage-lead">
              I'm based in Madrid and moving to the Netherlands. I review widely-used software for
              <span class="text-zinc-100">authentication and authorization bypasses</span>,
              <span class="text-zinc-100">supply-chain integrity problems</span> and
              <span class="text-zinc-100">denial-of-service bugs</span>.
            </p>
            <p data-i18n="about.p2" class="stage-note">
              Nobody assigned me this. I learned it by reading other people's code, and everything
              I find goes through the vendor's own disclosure process, never anywhere else.
            </p>
          </div>
        </div>
      </section>

      <!-- ---------------------- 02 · What I studied --------------------- -->
      <section id="education" class="stage">
        <div class="stage-in">
          <div class="stage-body stage-body-wide">
            <p class="station"><span class="station-no">02</span><span
                data-i18n="edu.eyebrow">What I've studied</span></p>
            <h2 data-i18n="edu.title" class="heading stage-title">
              Formal training,<br />plus the part I did myself.
            </h2>

            <div class="edu-grid">
              <div>
                <h3 data-i18n="edu.school" class="col-label">Education</h3>
                <ol class="timeline space-y-7">
                  {
                    education.map((item) => (
                      <li>
                        <p class="font-display text-sm font-semibold tracking-tight text-zinc-100">
                          {item.title}
                        </p>
                        {item.place && <p class="mt-1 text-sm text-zinc-500">{item.place}</p>}
                        <p class="mt-1 font-mono text-xs text-emerald-600">{item.period}</p>
                      </li>
                    ))
                  }
                </ol>
              </div>

              <div>
                <h3 data-i18n="edu.work" class="col-label">Experience</h3>
                <ol class="timeline space-y-7">
                  {
                    experience.map((item) => (
                      <li>
                        <p class="font-display text-sm font-semibold tracking-tight text-zinc-100">
                          {item.title}
                        </p>
                        <p class="mt-1 text-sm text-zinc-400">{item.place}</p>
                        <p class="mt-1 font-mono text-xs text-emerald-600">{item.period}</p>
                      </li>
                    ))
                  }
                </ol>
              </div>

              <div class="edu-certs">
                <h3 data-i18n="edu.certs" class="col-label">Self-directed certifications</h3>
                <ul class="flex flex-wrap gap-3">
                  {
                    certifications.map((cert) => (
                      <li>
                        <button
                          type="button"
                          class="cert-chip"
                          data-cert-image={cert.image}
                          data-cert-alt={`${cert.name}, ${cert.issuer}`}
                          aria-haspopup="dialog"
                        >
                          <span class="cert-chip-name">{cert.name}</span>
                          <span class="cert-chip-meta">
                            {cert.issuer} · {cert.date}
                          </span>
                        </button>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ---------------------- 03 · Who I work with -------------------- -->
      <section id="work" class="stage">
        <div class="stage-in">
          <div class="stage-body stage-body-wide">
            <p class="station"><span class="station-no">03</span><span
                data-i18n="work.eyebrow">Who I work with</span></p>
            <h2 data-i18n="work.title" class="heading stage-title">
              Google, Microsoft<br />and NVIDIA.
            </h2>

            <ol class="vendor-list">
              {
                vendors.map((v) => (
                  <li class="vendor">
                    <div class="vendor-top">
                      <span class="vendor-name">{v.name}</span>
                      <span class="vendor-scope">{v.scope}</span>
                      <span
                        class:list={[
                          'vendor-status',
                          v.statusKind === 'fixed' ? 'is-fixed' : 'is-open',
                        ]}
                        data-i18n={`work.${v.key}.status`}
                      >
                        {v.status}
                      </span>
                      <span class="vendor-sev">{v.severity}</span>
                      <span class="payout">{v.payout}</span>
                    </div>
                    <p class="vendor-desc" data-i18n={`work.${v.key}.desc`}>
                      {v.key === 'google' &&
                        "An authentication bypass in gRPC's xDS RBAC engine: the authenticatedMatcher fell through from the URI/DNS SAN to the certificate's Subject DN. Fixed by Google, and credited by name in the release notes."}
                      {v.key === 'microsoft' &&
                        'Reported through MSRC and currently under review. Details are withheld until it is resolved.'}
                      {v.key === 'nvidia' &&
                        "NVIDIA's security team confirmed and reproduced the report, which is now under active review. Details are withheld until it is resolved."}
                    </p>
                    {v.links.length > 0 && (
                      <div class="vendor-links">
                        {v.links.map((link) => (
                          <a href={link.href}>{link.label} &rarr;</a>
                        ))}
                      </div>
                    )}
                  </li>
                ))
              }
            </ol>

            <div class="work-foot">
              <p data-i18n="work.note" class="stage-note mt-0 text-xs">
                Open reports stay at this level: vendor, severity and status, nothing exploitable.
                They stay that way until the vendor resolves and publishes them.
              </p>
              <a href="/research/" data-i18n="work.all" class="work-all">All findings &rarr;</a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ============================ Skills ============================== -->
    <section id="skills" class="section-line relative isolate py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p data-i18n="skills.eyebrow" class="eyebrow reveal">Skills</p>
        <h2 data-i18n="skills.title" class="heading reveal mt-5 text-3xl font-bold sm:text-5xl">
          What I work with.
        </h2>
        <dl class="mt-14 grid gap-5 sm:grid-cols-2">
          {
            skills.map((group, i) => (
              <div class="card reveal p-6" style={`--reveal-delay: ${i * 80}ms`}>
                <dt
                  class="font-mono text-xs font-medium tracking-wider text-emerald-600 uppercase"
                  data-i18n={`skills.cat${i}`}
                >
                  {group.category}
                </dt>
                <dd class="mt-4 flex flex-wrap gap-2">
                  {group.items.split('·').map((item) => (
                    <span class="tag">{item.trim()}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- =========================== Projects ============================= -->
    <section id="projects" class="section-line relative isolate py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p data-i18n="projects.eyebrow" class="eyebrow reveal">Things I build</p>
        <h2 data-i18n="projects.title" class="heading reveal mt-5 text-3xl font-bold sm:text-5xl">
          What I build.
        </h2>
        <div class="mt-14 grid gap-5 sm:grid-cols-2">
          {
            projects.map((project, i) => (
              <a
                href={project.href}
                class="card reveal group flex flex-col p-6"
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <div class="flex items-center justify-between">
                  <h3 class="font-mono font-medium text-zinc-100">{project.name}</h3>
                  <svg
                    class="size-4 text-zinc-500 transition-colors group-hover:text-emerald-600"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17 5.3 18 5.6 18 5.6c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5A11.5 11.5 0 0 0 12 .5Z" />
                  </svg>
                </div>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
                  {project.description}
                </p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {project.tech.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </a>
            ))
          }
        </div>

        <p data-i18n="case.eyebrow" class="eyebrow reveal mt-20">Case study</p>
        <a href="/research/ies-jovellanos-zerologon/" class="card card-featured reveal group mt-6 block p-7">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <span class="font-medium text-zinc-100">IES Jovellanos</span>
            <span class="rounded-md border border-red-600/40 bg-red-500/12 px-2 py-0.5 text-red-700">
              CVSS 10.0 (Critical)
            </span>
            <span
              data-i18n="case.status"
              class="rounded-md border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-emerald-600"
            >
              Disclosed &amp; remediated
            </span>
          </div>
          <h3
            data-i18n="case.title"
            class="font-display mt-4 text-lg font-semibold tracking-tight text-zinc-100"
          >
            Domain compromise via ZeroLogon (CVE-2020-1472), and the fix
          </h3>
          <p data-i18n="case.desc" class="mt-2 text-sm leading-relaxed text-zinc-400">
            I found my school's domain controller exposed to ZeroLogon, demonstrated the impact
            responsibly, reported it immediately, and worked with the school to remediate and harden
            the infrastructure.
          </p>
          <span
            data-i18n="case.link"
            class="mt-4 inline-block font-mono text-xs text-emerald-600 group-hover:text-emerald-500"
          >
            Read the case study &rarr;
          </span>
        </a>
      </div>
      <dialog id="cert-lightbox" class="cert-lightbox" aria-label="Certificate">
        <button
          type="button"
          id="cert-lightbox-close"
          aria-label="Cerrar / Close"
          class="glass-pill absolute top-3 right-3 z-10 flex size-9 cursor-pointer items-center justify-center rounded-full border border-zinc-700 bg-zinc-950/90 text-lg text-zinc-300 transition-colors hover:border-emerald-500 hover:text-emerald-600"
        >
          &times;
        </button>
        <img id="cert-lightbox-img" alt="" />
      </dialog>
    </section>

    <!-- ============================ Contact ============================= -->
    <section id="contact" class="section-line relative isolate py-32 sm:py-44">
      <div class="mx-auto max-w-5xl px-6 text-center">
        <h2
          data-i18n="contact.title"
          class="heading reveal text-4xl font-bold tracking-tighter sm:text-7xl"
        >
          Let's talk<span class="text-emerald-600">.</span>
        </h2>
        <p
          data-i18n="contact.desc"
          class="reveal mx-auto mt-7 max-w-xl text-zinc-400"
          style="--reveal-delay: 100ms"
        >
          Open to junior roles in application security, vulnerability research or security
          engineering, in the Netherlands or remote.
        </p>
        <div class="reveal mt-11" style="--reveal-delay: 200ms">
          <a href="mailto:alanortega7312@gmail.com" class="btn btn-primary px-8 py-3.5 !text-base">
            alanortega7312@gmail.com
          </a>
        </div>
        <ul
          class="reveal mt-11 flex flex-wrap justify-center gap-3 font-mono text-sm"
          style="--reveal-delay: 300ms"
        >
          <li><a href="https://github.com/al4an444" class="chip !text-sm">github.com/al4an444</a></li>
          <li>
            <a href="https://www.linkedin.com/in/alan-o-b70724290" class="chip !text-sm">linkedin</a>
          </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  /* ------------- Certificate lightbox ------------- */
  const lightbox = document.getElementById('cert-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('cert-lightbox-img') as HTMLImageElement | null;
  if (lightbox && lightboxImg) {
    const img = lightboxImg;
    const box = lightbox;
    document.querySelectorAll<HTMLButtonElement>('[data-cert-image]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.certImage ?? '';
        img.alt = btn.dataset.certAlt ?? '';
        box.setAttribute('aria-label', img.alt || 'Certificate');
        box.showModal();
      });
    });
    document.getElementById('cert-lightbox-close')?.addEventListener('click', () => box.close());
    // A click that lands on the dialog itself (not its children) is on the backdrop.
    box.addEventListener('click', (event) => {
      if (event.target === box) box.close();
    });
  }
</script>
