---
import '../styles/global.css';
// Two variable files, weight axis only — the whole type system. Archivo carries
// display and body; Chivo Mono is the data voice.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/chivo-mono/wght.css';
import { langFromUrl, alternatePath, type Lang } from '../i18n/lang';

interface Props {
  title: string;
  description: string;
  // false for pages that exist in only one language (404): no hreflang pair.
  alternate?: boolean;
  // Extra JSON-LD nodes for this page (e.g. a BlogPosting on a writeup).
  schema?: Record<string, unknown>[];
}

const { title, description, alternate = true, schema = [] } = Astro.props;
const lang: Lang = langFromUrl(Astro.url);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altUrl = new URL(alternatePath(Astro.url, lang), site);
const enUrl = lang === 'en' ? canonical : altUrl;
const esUrl = lang === 'es' ? canonical : altUrl;

// The full name, spelled out everywhere a crawler reads it. "Alan Ortega" alone
// is shared by thousands of people; the second surname is what makes this
// person findable, so it goes in <title>, the h1, the schema and the footer.
const personId = new URL('/#person', site).href;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Alan Ortega Álamo',
  givenName: 'Alan',
  familyName: 'Ortega Álamo',
  alternateName: ['Alan Ortega Alamo', 'Alan Ortega', 'al4an444'],
  jobTitle: lang === 'es' ? 'Investigador de seguridad' : 'Security Researcher',
  description:
    lang === 'es'
      ? 'Investigador de seguridad autodidacta que encuentra y divulga responsablemente vulnerabilidades en software de uso masivo.'
      : 'Self-taught security researcher finding and responsibly disclosing vulnerabilities in widely-used software.',
  url: site.href,
  image: new URL('/og.png', site).href,
  email: 'mailto:alanortega7312@gmail.com',
  homeLocation: { '@type': 'Place', name: 'Madrid, Spain' },
  knowsAbout: [
    'Vulnerability research',
    'Source-code review',
    'Application security',
    'Authentication and authorization bypasses',
    'Responsible disclosure',
  ],
  // Profiles only — every URL here must be a page about this person.
  sameAs: [
    'https://github.com/al4an444',
    'https://www.linkedin.com/in/alan-o-b70724290',
    'https://www.instagram.com/_.alaaan._5/',
  ],
};
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', site).href,
  url: site.href,
  name: 'Alan Ortega Álamo',
  inLanguage: ['en', 'es'],
  author: { '@id': personId },
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, ...schema],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The site loads nothing off-origin, so lock that in. GitHub Pages cannot
        set response headers, so this caps the damage of a future supply-chain
        injection rather than replacing real headers. frame-ancestors is
        ignored in meta and is therefore not attempted here. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="Eadhzg2U7FBVdj4SxqI1_VtszU0XAzZAuVFx-SXwNGY" />
    <link rel="canonical" href={canonical} />
    {
      alternate && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {alternate && <meta property="og:locale:alternate" content={altLang === 'es' ? 'es_ES' : 'en_US'} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alan Ortega Álamo · Security Researcher" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script is:inline>
      // Marks JS availability so reveal styles only hide content when the
      // IntersectionObserver below is actually going to run.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------------- Reveal on scroll ---------------- */
      const targets = document.querySelectorAll('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }

      /* ----------------- Nav scrollspy -------------------- */
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link][href*="#"]');
      if (navLinks.length > 0 && 'IntersectionObserver' in window) {
        const sections = [...navLinks]
          .map((link) => document.getElementById(link.href.split('#')[1]))
          .filter((s): s is HTMLElement => s !== null);
        if (sections.length > 0) {
          const spy = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  navLinks.forEach((link) =>
                    link.setAttribute(
                      'aria-current',
                      String(link.href.split('#')[1] === entry.target.id)
                    )
                  );
                }
              }
            },
            { rootMargin: '-40% 0px -55% 0px' }
          );
          sections.forEach((s) => spy.observe(s));
        }
      }

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
