---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FindingCard from '../../components/FindingCard.astro';
import { findings } from '../../data/findings';

const writeups = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Security Research · Alan Ortega"
  description="Vulnerability findings and technical writeups by Alan Ortega: authentication/authorization bypasses, supply-chain integrity and denial-of-service issues in widely-used open-source software."
>
  <Nav />
  <main id="top" class="mx-auto max-w-4xl px-6 pt-36 pb-20">
    <p class="eyebrow"># Research index</p>
    <h1 class="heading mt-4 text-4xl font-bold sm:text-5xl">Security Research</h1>
    <p class="mt-4 max-w-2xl text-zinc-400">
      Findings reported responsibly through Google's Open Source VRP / Bug Hunters and vendor
      bug-bounty programs. Detailed writeups are published only once a finding is public; active
      reports are listed at a high level: vendor, severity and status, with no exploitable
      details.
    </p>

    <h2 class="eyebrow mt-14 mb-6"># Findings</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      {findings.map((finding) => <FindingCard finding={finding} />)}
    </div>

    <h2 class="eyebrow mt-16 mb-6"># Writeups</h2>
    {
      writeups.length === 0 ? (
        <p class="text-sm text-zinc-500">
          First writeup in progress: the grpc-go xDS RBAC authentication bypass, now public in
          <a href="https://github.com/grpc/grpc-go/pull/9111" class="text-emerald-400 hover:text-emerald-300">
            {' '}PR #9111
          </a>{' '}and shipped in v1.81.1.
        </p>
      ) : (
        <ul class="space-y-5">
          {writeups.map((post) => (
            <li>
              <a href={`/research/${post.id}/`} class="card block p-6">
                <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
                  <span class="font-medium text-zinc-100">{post.data.project}</span>
                  {post.data.severity && (
                    <span
                      class:list={[
                        'rounded-md border px-2 py-0.5',
                        post.data.severity.toLowerCase().includes('critical')
                          ? 'border-red-600/40 bg-red-500/12 text-red-700'
                          : 'border-emerald-500/40 bg-emerald-500/10 text-emerald-600',
                      ]}
                    >
                      {post.data.severity}
                    </span>
                  )}
                  <span class="text-zinc-500">
                    {post.data.date.toISOString().slice(0, 10)}
                  </span>
                </div>
                <h3 class="font-display mt-3 font-semibold tracking-tight text-zinc-100">
                  {post.data.title}
                </h3>
                <p class="mt-1.5 text-sm text-zinc-400">{post.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <Footer />
</Base>
