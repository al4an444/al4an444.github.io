---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FieldArt from '../components/FieldArt.astro';
---

<Base
  title="Nothing here · Alan Ortega"
  description="This address does not exist on al4an444.github.io."
>
  <Nav />
  <main id="top" class="notfound">
    <section class="notfound-in">
      <p class="notfound-kicker">
        <span data-i18n="nf.kicker">Dead end</span>
      </p>

      <h1 class="name-draw notfound-code">
        <span class="name-ink">404</span>
        <span class="name-pen" aria-hidden="true"></span>
      </h1>

      <p data-i18n="nf.title" class="notfound-title">This path leads nowhere.</p>

      <p data-i18n="nf.lead" class="notfound-lead">
        You went looking for something that isn't here. Poking at addresses is most of the job, so
        I won't hold it against you. This one is just a dead end.
      </p>

      <div class="notfound-actions">
        <a href="/" data-i18n="nf.btn.home" class="btn btn-primary">Back to the start</a>
        <a href="/research/" data-i18n="nf.btn.research" class="btn btn-ghost">See the research</a>
      </div>

      <FieldArt
        seed={0x404}
        traces={70}
        width={150}
        height={150}
        accentIndex={23}
        class="notfound-mark"
      />
    </section>
  </main>
  <Footer />
</Base>
