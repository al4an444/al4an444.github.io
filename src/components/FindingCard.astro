---
import type { Finding } from '../data/findings';

interface Props {
  finding: Finding;
}

const { finding } = Astro.props;

const statusStyles: Record<Finding['statusKind'], string> = {
  fixed: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400',
  accepted: 'border-sky-500/40 bg-sky-500/10 text-sky-400',
  reported: 'border-zinc-600 bg-zinc-800/60 text-zinc-400',
  duplicate: 'border-violet-500/40 bg-violet-500/10 text-violet-300',
};

// Critical severities get a red badge; everything else uses the accent colour.
const isCritical = finding.severity?.toLowerCase().includes('critical');
const severityStyle = isCritical
  ? 'border-red-500/50 bg-red-500/10 text-red-400'
  : 'border-emerald-400/40 bg-emerald-400/10 text-emerald-400';
---

<article class:list={['card reveal p-6', finding.featured && 'card-featured']}>
  <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
    <span class="font-medium text-zinc-100">{finding.project}</span>
    {
      finding.severity && (
        <span class:list={['rounded-md border px-2 py-0.5', severityStyle]}>
          {finding.severity}
        </span>
      )
    }
    <span
      class:list={[
        'inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5',
        statusStyles[finding.statusKind],
      ]}
    >
      <span class="size-1.5 rounded-full bg-current opacity-80"></span>
      {finding.status}
    </span>
  </div>
  <h3 class="mt-3.5 font-display font-semibold tracking-tight text-zinc-100">{finding.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-zinc-400">{finding.summary}</p>
  {
    finding.links && finding.links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {finding.links.map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs text-emerald-400 transition-colors hover:text-emerald-300"
          >
            {link.label} &rarr;
          </a>
        ))}
      </div>
    )
  }
</article>
