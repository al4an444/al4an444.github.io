---
import T from './T.astro';

const year = new Date().getFullYear();
---

<footer class="band-tight">
  <div class="wrap">
    <div class="footer-in">
      <p class="t-data-sm">© {year} Alan Ortega Álamo</p>
      <div class="footer-links">
        <a href="mailto:alanortega7312@gmail.com" class="link">Email</a>
        <a href="https://github.com/al4an444" class="link" rel="me">GitHub</a>
        <a href="https://linkedin.com/in/alan-o-b70724290" class="link" rel="me">LinkedIn</a>
        <a href="/.well-known/security.txt" class="link">security.txt</a>
      </div>
      <p class="t-data-sm"><T k="footer.built">Astro · no client JS</T></p>
    </div>
  </div>
</footer>

<style>
  .footer-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
