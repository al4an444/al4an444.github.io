---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FindingCard from '../components/FindingCard.astro';
import { findings, additionalReports, platforms } from '../data/findings';

const featured = findings.find((f) => f.featured)!;
const rest = findings.filter((f) => !f.featured);

const stats = [
  { value: '12', label: "reports submitted · Google's OSS VRP" },
  { value: '9', label: 'Google open-source projects reviewed' },
  { value: '7.5', label: 'CVSS of the grpc-go bug Google fixed' },
  { value: '4', label: 'bug-bounty platforms active on' },
];

const skills = [
  {
    category: 'Security',
    items:
      'Vulnerability research · source-code review (Go & Python) · authentication/authorization bypass analysis · supply-chain & build integrity · denial-of-service analysis · Active Directory exploitation (ZeroLogon, DCSync, Pass-the-Hash) · responsible disclosure · CVSS v3.1 scoring · PoC development',
  },
  {
    category: 'Programming',
    items: 'Go · Python · Bash · frontend & backend web',
  },
  {
    category: 'Systems & Networking',
    items: 'Linux & Windows administration · network configuration · virtualization',
  },
  {
    category: 'Languages',
    items: 'Spanish (native) · English (professional working proficiency)',
  },
];

const education = [
  {
    title: 'Higher Vocational Degree (HND) — Network Systems Administration (ASIR)',
    place: 'IES Jovellanos / ILERNA Online',
    period: '2025 – 2027 (in progress)',
  },
  {
    title: 'Vocational Diploma — Microcomputer Systems & Networks (SMR)',
    place: '',
    period: '2023 – 2025',
  },
];

const experience = [
  {
    title: 'Technical Support',
    place: 'MOMPALAO — IT company, Malta',
    period: 'Mar – May 2025',
  },
  {
    title: 'Ride Operator',
    place: 'Slagharen Theme Park, Netherlands',
    period: 'Jul – Aug 2025',
  },
  {
    title: 'Retail Associate',
    place: 'El Corte Inglés, Spain',
    period: 'Nov 2024 – Jan 2025',
  },
];

const glance = [
  { label: 'Role', value: 'Security Researcher' },
  { label: 'Focus', value: 'Source-code review (Go & Python)' },
  { label: 'Track record', value: '12 reports · Google OSS VRP' },
  { label: 'Highlight', value: 'grpc-go CVSS 7.5 — fixed by Google' },
  { label: 'Education', value: 'ASIR (HND), 2025–2027' },
  { label: 'Languages', value: 'Spanish · English' },
  { label: 'Location', value: 'Madrid → Netherlands' },
  { label: 'Open to', value: 'Junior appsec / vuln research · NL or remote' },
];
---

<Base
  title="Alan Ortega — Security Researcher"
  description="Security researcher finding and responsibly disclosing vulnerabilities in open-source software. 12 reports through Google's Open Source VRP, including a CVSS 7.5 authentication bypass in grpc-go fixed by Google."
>
  <Nav />
  <main>
    <!-- ============================== Hero ============================== -->
    <section class="glow relative flex min-h-[100svh] flex-col justify-center">
      <div class="hero-exit mx-auto w-full max-w-5xl px-6 pt-14">
        <p class="reveal mb-6 font-mono text-sm text-amber-400">$ whoami</p>
        <h1
          class="reveal text-5xl font-bold tracking-tighter text-zinc-100 sm:text-7xl lg:text-8xl"
          style="--reveal-delay: 80ms"
        >
          Alan Ortega
        </h1>
        <p
          class="reveal mt-6 max-w-3xl text-xl leading-snug font-medium text-zinc-300 sm:text-2xl"
          style="--reveal-delay: 160ms"
        >
          I find vulnerabilities in software the world runs on —
          <span class="text-amber-400">and report them responsibly.</span>
        </p>
        <p class="reveal mt-5 max-w-2xl leading-relaxed text-zinc-400" style="--reveal-delay: 240ms">
          Security researcher reviewing source code (mostly Go) for authentication/authorization
          bypasses, supply-chain weaknesses and other flaws — reported through Google's Open Source
          Vulnerability Reward Program.
        </p>
        <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 320ms">
          <a
            href="#research"
            class="rounded-full bg-amber-400 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-amber-300"
          >
            View research
          </a>
          <a
            href="https://github.com/al4an444"
            class="rounded-full border border-zinc-700 px-5 py-2.5 text-sm text-zinc-200 transition-colors hover:border-zinc-500"
          >
            GitHub
          </a>
          <a
            href="/cv.pdf"
            class="rounded-full border border-zinc-700 px-5 py-2.5 text-sm text-zinc-200 transition-colors hover:border-zinc-500"
          >
            Download CV
          </a>
          <a
            href="#contact"
            class="rounded-full border border-zinc-700 px-5 py-2.5 text-sm text-zinc-200 transition-colors hover:border-zinc-500"
          >
            Contact
          </a>
        </div>
      </div>
      <div class="absolute inset-x-0 bottom-8 flex justify-center">
        <a href="#stats" aria-label="Scroll down" class="scroll-hint text-zinc-500">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </section>

    <!-- ============================ Numbers ============================= -->
    <section id="stats" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># In numbers</p>
        <h2 class="reveal mt-4 max-w-2xl text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          Real findings. Verifiable impact.
        </h2>
        <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-4">
          {
            stats.map((stat, i) => (
              <div class="reveal" style={`--reveal-delay: ${i * 100}ms`}>
                <dd class="font-mono text-5xl font-bold tracking-tight text-amber-400 sm:text-6xl">
                  {stat.value}
                </dd>
                <dt class="mt-3 text-sm leading-snug text-zinc-400">{stat.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============================= About ============================== -->
    <section id="about" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># About</p>
        <p class="reveal mt-8 max-w-3xl text-2xl leading-snug font-medium text-zinc-400 sm:text-3xl">
          I'm a <span class="text-zinc-100">20-year-old security researcher</span> based in Madrid,
          relocating to the Netherlands. I review widely-used open-source projects for
          <span class="text-zinc-100">authentication & authorization bypasses</span>,
          <span class="text-zinc-100">supply-chain integrity issues</span> and
          <span class="text-zinc-100">denial-of-service bugs</span>.
        </p>
        <p class="reveal mt-8 max-w-3xl text-2xl leading-snug font-medium text-zinc-400 sm:text-3xl" style="--reveal-delay: 120ms">
          My work goes through Google's Open Source VRP — including a vulnerability in grpc-go that
          <span class="text-amber-400">Google fixed</span>. Currently completing a Higher Vocational
          Degree in Network Systems Administration.
        </p>
      </div>
    </section>

    <!-- ======================== Featured finding ======================== -->
    <section class="glow border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># Featured finding</p>
        <h2 class="reveal mt-4 max-w-3xl text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          Breaking authentication<br />in gRPC's RBAC engine.
        </h2>
        <div class="mt-14 grid items-start gap-10 lg:grid-cols-2">
          <div class="space-y-5 lg:sticky lg:top-28">
            <p class="reveal leading-relaxed text-zinc-400">
              In <span class="font-mono text-zinc-200">grpc-go</span> — the Go implementation of
              gRPC, used across cloud infrastructure worldwide — the xDS RBAC
              <span class="font-mono text-zinc-200">authenticatedMatcher</span> fell through from
              the URI/DNS SAN to the certificate's Subject DN.
            </p>
            <p class="reveal leading-relaxed text-zinc-400" style="--reveal-delay: 100ms">
              The result: an <span class="text-zinc-200">authentication bypass</span> in the
              authorization layer, scored <span class="text-amber-400">CVSS 7.5 (High)</span>.
              Reported through Google's Open Source VRP —
              <span class="text-emerald-400">and fixed by Google</span>.
            </p>
            <p class="reveal leading-relaxed text-zinc-400" style="--reveal-delay: 200ms">
              Now public: merged in <span class="font-mono text-zinc-200">PR #9111</span> and shipped
              in <span class="font-mono text-zinc-200">grpc-go v1.81.1</span>, whose release notes
              credit me by name.
            </p>
            <div class="reveal flex flex-wrap gap-3" style="--reveal-delay: 280ms">
              <a
                href="https://github.com/grpc/grpc-go/pull/9111"
                class="rounded-full border border-zinc-700 px-4 py-2 font-mono text-xs text-zinc-200 transition-colors hover:border-amber-400 hover:text-amber-400"
              >
                Fix PR #9111 &rarr;
              </a>
              <a
                href="https://newreleases.io/project/github/grpc/grpc-go/release/v1.81.1"
                class="rounded-full border border-zinc-700 px-4 py-2 font-mono text-xs text-zinc-200 transition-colors hover:border-amber-400 hover:text-amber-400"
              >
                Release notes &rarr;
              </a>
            </div>
          </div>
          <div class="reveal" style="--reveal-delay: 150ms">
            <div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/60 shadow-[0_20px_80px_-20px_rgb(251_191_36/0.15)]">
              <div class="flex items-center gap-1.5 border-b border-zinc-800 px-4 py-3">
                <span class="size-3 rounded-full bg-zinc-700"></span>
                <span class="size-3 rounded-full bg-zinc-700"></span>
                <span class="size-3 rounded-full bg-zinc-700"></span>
                <span class="ml-3 font-mono text-xs text-zinc-500">report — grpc-go</span>
              </div>
              <div class="space-y-2.5 p-5 font-mono text-sm">
                <p class="text-zinc-500">$ cat report/grpc-go-xds-rbac</p>
                <p><span class="text-zinc-500">project    </span><span class="text-zinc-200">grpc-go (Google)</span></p>
                <p><span class="text-zinc-500">class      </span><span class="text-zinc-200">authentication bypass</span></p>
                <p><span class="text-zinc-500">component  </span><span class="text-zinc-200">xDS RBAC · authenticatedMatcher</span></p>
                <p><span class="text-zinc-500">severity   </span><span class="text-amber-400">CVSS 7.5 — HIGH</span></p>
                <p><span class="text-zinc-500">program    </span><span class="text-zinc-200">Google Open Source VRP</span></p>
                <p><span class="text-zinc-500">fix        </span><span class="text-zinc-200">PR #9111 · v1.81.1</span></p>
                <p><span class="text-zinc-500">status     </span><span class="text-emerald-400">FIXED BY GOOGLE ✓</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================== Research ============================= -->
    <section id="research" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># Security research</p>
        <h2 class="reveal mt-4 max-w-2xl text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          More findings.
        </h2>
        <p class="reveal mt-4 max-w-2xl text-zinc-400">
          Reported responsibly through Google's Open Source VRP / Bug Hunters and public
          bug-bounty platforms.
        </p>
        <ul class="reveal mt-6 flex flex-wrap gap-2 font-mono text-xs">
          {
            platforms.map((p) => (
              <li class="rounded-full border border-zinc-700 px-3 py-1 text-zinc-300">{p}</li>
            ))
          }
        </ul>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((finding, i) => <FindingCard finding={finding} />)}
        </div>
        <div class="reveal mt-4 rounded-xl border border-zinc-800 bg-zinc-900/40 p-6">
          <h3 class="font-mono text-xs text-zinc-400">+ Additional reports</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">
            Across {additionalReports.projects.map((p, i) => (
              <span><span class="font-mono text-zinc-300">{p}</span>{i < additionalReports.projects.length - 1 ? ', ' : ''}</span>
            ))} — covering {additionalReports.topics}.
          </p>
          <p class="mt-3 font-mono text-xs text-zinc-500">
            Total: {additionalReports.total} vulnerability reports submitted to Google's Open
            Source VRP.
          </p>
        </div>
        <p class="reveal mt-6 text-xs leading-relaxed text-zinc-600">
          Detailed technical writeups are published only for findings that are already public.
          Non-public reports are listed at a high level — project, vulnerability class and status —
          with no exploitable details, in line with responsible disclosure.
        </p>
      </div>
    </section>

    <!-- ============================ Skills ============================== -->
    <section id="skills" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># Skills</p>
        <h2 class="reveal mt-4 text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          What I work with.
        </h2>
        <dl class="mt-12 grid gap-4 sm:grid-cols-2">
          {
            skills.map((group, i) => (
              <div
                class="reveal rounded-xl border border-zinc-800 bg-zinc-900/40 p-6"
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <dt class="font-mono text-xs font-medium text-amber-400">{group.category}</dt>
                <dd class="mt-3 text-sm leading-relaxed text-zinc-400">{group.items}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ===================== Experience & Education ===================== -->
    <section id="experience" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># Experience &amp; education</p>
        <h2 class="reveal mt-4 text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          The timeline.
        </h2>
        <div class="mt-12 grid gap-12 sm:grid-cols-2">
          <div class="reveal">
            <h3 class="mb-5 font-mono text-xs tracking-wide text-zinc-500 uppercase">Education</h3>
            <ol class="space-y-6 border-l border-zinc-800 pl-5">
              {
                education.map((item) => (
                  <li>
                    <p class="text-sm font-medium text-zinc-200">{item.title}</p>
                    {item.place && <p class="mt-0.5 text-sm text-zinc-500">{item.place}</p>}
                    <p class="mt-0.5 font-mono text-xs text-zinc-600">{item.period}</p>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="reveal" style="--reveal-delay: 120ms">
            <h3 class="mb-5 font-mono text-xs tracking-wide text-zinc-500 uppercase">Experience</h3>
            <ol class="space-y-6 border-l border-zinc-800 pl-5">
              {
                experience.map((item) => (
                  <li>
                    <p class="text-sm font-medium text-zinc-200">{item.title}</p>
                    <p class="mt-0.5 text-sm text-zinc-500">{item.place}</p>
                    <p class="mt-0.5 font-mono text-xs text-zinc-600">{item.period}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================== At a glance =========================== -->
    <section id="glance" class="border-t border-zinc-900 py-28 sm:py-36">
      <div class="mx-auto max-w-5xl px-6">
        <p class="reveal font-mono text-sm text-amber-400"># At a glance</p>
        <h2 class="reveal mt-4 text-3xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
          Everything, in 10 seconds.
        </h2>
        <dl class="mt-12 grid gap-px overflow-hidden rounded-xl border border-zinc-800 bg-zinc-800 sm:grid-cols-2 lg:grid-cols-4">
          {
            glance.map((item, i) => (
              <div class="reveal bg-zinc-950 p-6" style={`--reveal-delay: ${i * 60}ms`}>
                <dt class="font-mono text-xs text-zinc-500">{item.label}</dt>
                <dd class="mt-2 text-sm font-medium text-zinc-200">{item.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="reveal mt-8 flex flex-wrap gap-3">
          <a
            href="/cv.pdf"
            class="rounded-full bg-amber-400 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-amber-300"
          >
            Download CV
          </a>
          <a
            href="/research/"
            class="rounded-full border border-zinc-700 px-5 py-2.5 text-sm text-zinc-200 transition-colors hover:border-zinc-500"
          >
            Full research list
          </a>
        </div>
      </div>
    </section>

    <!-- ============================ Contact ============================= -->
    <section id="contact" class="glow border-t border-zinc-900 py-32 sm:py-44">
      <div class="mx-auto max-w-5xl px-6 text-center">
        <h2 class="reveal text-4xl font-bold tracking-tighter text-zinc-100 sm:text-6xl">
          Let's find the next bug<span class="text-amber-400">.</span>
        </h2>
        <p class="reveal mx-auto mt-6 max-w-xl text-zinc-400" style="--reveal-delay: 100ms">
          Open to junior roles in application security, vulnerability research or security
          engineering — Netherlands or remote.
        </p>
        <div class="reveal mt-10" style="--reveal-delay: 200ms">
          <a
            href="mailto:alanortega7312@gmail.com"
            class="inline-block rounded-full bg-amber-400 px-7 py-3 font-semibold text-zinc-950 transition-colors hover:bg-amber-300"
          >
            alanortega7312@gmail.com
          </a>
        </div>
        <ul class="reveal mt-10 flex flex-wrap justify-center gap-6 font-mono text-sm" style="--reveal-delay: 300ms">
          <li>
            <a href="https://github.com/al4an444" class="text-zinc-400 transition-colors hover:text-amber-400">
              github.com/al4an444
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/alan-o-b70724290" class="text-zinc-400 transition-colors hover:text-amber-400">
              linkedin
            </a>
          </li>
          <li>
            <a href="/cv.pdf" class="text-zinc-400 transition-colors hover:text-amber-400">cv.pdf</a>
          </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
