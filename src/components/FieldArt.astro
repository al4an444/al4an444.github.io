---
// Plotter Field — a precomputed, seeded generative line drawing. Hundreds of
// hairline "ink" traces follow a smooth flow field; exactly ONE trace is drawn
// in the accent colour, the thread that slips through the field. Generated at
// build time (frontmatter only) → ships zero client JS and is deterministic,
// so the same seed always yields identical, cacheable SVG.
//
// `backdrop` mounts it as the fixed full-bleed layer (see `.field-art`);
// otherwise it renders inline as a small "thumbprint" (see `.field-mark`).
interface Props {
  seed?: number;
  traces?: number;
  steps?: number;
  width?: number;
  height?: number;
  accentIndex?: number;
  backdrop?: boolean;
  class?: string;
}

const {
  seed = 0x5eed,
  traces = 240,
  steps = 36,
  width = 1280,
  height = 860,
  accentIndex = 137,
  backdrop = false,
  class: className = '',
} = Astro.props;

// Small, fast, deterministic PRNG.
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);

// Flow-field parameters derived from the seed, so each seed is a distinct field.
const f1 = 0.0016 + rand() * 0.0022;
const f2 = 0.0016 + rand() * 0.0022;
const f3 = 0.0011 + rand() * 0.0018;
const p1 = rand() * Math.PI * 2;
const p2 = rand() * Math.PI * 2;
const p3 = rand() * Math.PI * 2;
const swirl = 1.4 + rand() * 1.2;

const angleAt = (x: number, y: number) =>
  (Math.sin(x * f1 + p1) + Math.cos(y * f2 + p2) + Math.sin((x + y) * f3 + p3)) * swirl;

const stepLen = Math.max(width, height) / 46;
const margin = 40;

// Trace the field from random seed points into simplified polylines.
const paths: string[] = [];
for (let i = 0; i < traces; i++) {
  let x = rand() * width;
  let y = rand() * height;
  const pts: string[] = [`${x.toFixed(1)},${y.toFixed(1)}`];
  for (let s = 0; s < steps; s++) {
    const a = angleAt(x, y);
    x += Math.cos(a) * stepLen;
    y += Math.sin(a) * stepLen;
    if (x < -margin || x > width + margin || y < -margin || y > height + margin) break;
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  // Skip degenerate one-point traces.
  if (pts.length > 1) paths.push(pts.join(' '));
}

const accent = paths.length ? (((accentIndex % paths.length) + paths.length) % paths.length) : 0;
const field = paths.filter((_, i) => i !== accent);
const thread = paths[accent];

const viewBox = `0 0 ${width} ${height}`;
---

{
  backdrop ? (
    <div class:list={['field-art', className]} aria-hidden="true">
      <svg
        viewBox={viewBox}
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g stroke="currentColor" stroke-width="1" stroke-opacity="0.07">
          {field.map((d) => (
            <polyline points={d} />
          ))}
        </g>
        {thread && (
          <polyline
            class="field-thread"
            points={thread}
            stroke="var(--color-accent)"
            stroke-width="1.6"
            stroke-opacity="0.75"
            stroke-linecap="round"
          />
        )}
      </svg>
    </div>
  ) : (
    <svg
      class:list={['field-mark', className]}
      width={width}
      height={height}
      viewBox={viewBox}
      preserveAspectRatio="xMidYMid meet"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <g stroke="currentColor" stroke-width="1" stroke-opacity="0.14">
        {field.map((d) => (
          <polyline points={d} />
        ))}
      </g>
      {thread && (
        <polyline
          points={thread}
          stroke="var(--color-accent)"
          stroke-width="1.6"
          stroke-opacity="0.9"
          stroke-linecap="round"
        />
      )}
    </svg>
  )
}
